---
interface Props {
    title?: string
    url?: string
}

const { title = 'Continue with X', url = '#' } = Astro.props
---

<a
    href={url}
    class="group inline-flex items-center justify-center gap-2 rounded-lg border-[1.5px] border-neutral-200 bg-white px-6 py-3 text-sm font-medium text-neutral-700 transition hover:border-neutral-300 hover:text-neutral-900 focus:outline-none focus:ring-1 focus:ring-neutral-300 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:border-neutral-600 dark:hover:text-neutral-300 dark:focus:ring-neutral-600"
>
    {title}
    <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
        <path
            fill="currentColor"
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        />
    </svg>
</a>
